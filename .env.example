# ==========================================
# ImageSpace 环境变量配置示例
# 复制本文件为 .env 并填写实际值
# ==========================================

# ----- MySQL -----
MYSQL_ROOT_PASSWORD=change-me
DB_USERNAME=picuser
DB_PASSWORD=change-me

# ----- Redis -----
REDIS_PASSWORD=

# ----- Storage (R2) -----
STORAGE_TYPE=r2
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://cdn.image-space.app

# ----- App URLs -----
APP_PUBLIC_BASE_URL=https://image-space.app
APP_FRONTEND_BASE_URL=https://image-space.app
APP_WEBHOOK_PATH=/api/webhook

# ----- Mail -----
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ----- Cloudflare -----
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# ----- Internal -----
BACKEND_INTERNAL_TOKEN=

# ----- Upstash Redis (可选) -----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----- GitHub OAuth -----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://image-space.app/api/user/oauth/github/callback

# ----- Google OAuth -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://image-space.app/api/user/oauth/google/callback

# ----- Microsoft OAuth -----
# 在 Microsoft Entra ID (Azure AD) 注册应用后获取
# 应用注册: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
# Redirect URI 填写: https://你的域名/api/user/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://image-space.app/api/user/oauth/microsoft/callback
FRONTEND_MICROSOFT_LOGIN_SUCCESS_URL=
FRONTEND_MICROSOFT_LOGIN_FAILURE_URL=

# ----- Cloudflare Turnstile -----
VITE_TURNSTILE_ENABLED=false
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
