# ==========================================
# AstralSpace 环境变量配置示例
# 复制本文件为 .env 并填写实际值
# ==========================================

# ----- MySQL -----
MYSQL_ROOT_PASSWORD=change-me
DB_USERNAME=picuser
DB_PASSWORD=change-me
IMAGE_REVISION=unknown

# ----- Redis -----
REDIS_PASSWORD=

# ----- Storage (R2) -----
STORAGE_TYPE=r2
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://cdn.image-space.app

# ----- App URLs -----
APP_PUBLIC_BASE_URL=https://image-space.app
APP_FRONTEND_BASE_URL=https://image-space.app
APP_WEBHOOK_PATH=/api/webhook
APP_ADMIN_ALLOW_LOCAL=false
VITE_ADMIN_ALLOW_LOCAL=false

# ----- Mail -----
# 本地/回退使用 smtp；生产腾讯云邮件推送 API 使用 tencent-ses
MAIL_PROVIDER=smtp
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# 腾讯云模板正文使用 {{code}}，并在模板文案中说明验证码 5 分钟内有效
TENCENT_SES_SECRET_ID=
TENCENT_SES_SECRET_KEY=
TENCENT_SES_REGION=ap-guangzhou
TENCENT_SES_FROM_ADDRESS=AstralSpace <no-reply@mail.image-space.app>
TENCENT_SES_SUBJECT=AstralSpace 验证码
TENCENT_SES_TEMPLATE_ID=

# ----- Cloudflare -----
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# ----- Internal -----
BACKEND_INTERNAL_TOKEN=

# ----- Upstash Redis (可选) -----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----- GitHub OAuth -----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://image-space.app/api/user/oauth/github/callback

# ----- Google OAuth -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://image-space.app/api/user/oauth/google/callback

# ----- Microsoft OAuth -----
# 在 Microsoft Entra ID (Azure AD) 注册应用后获取
# 应用注册: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
# Redirect URI 填写: https://你的域名/api/user/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://image-space.app/api/user/oauth/microsoft/callback
FRONTEND_MICROSOFT_LOGIN_SUCCESS_URL=
FRONTEND_MICROSOFT_LOGIN_FAILURE_URL=

# ----- Cloudflare Turnstile -----
VITE_TURNSTILE_ENABLED=false
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# RabbitMQ: set a unique password before starting Docker Compose.
MESSAGING_ENABLED=true
RABBITMQ_USERNAME=image-space
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=image-space
