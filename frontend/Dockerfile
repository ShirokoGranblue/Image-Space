FROM node:22-alpine AS build
WORKDIR /app
ARG VITE_TURNSTILE_ENABLED=false
ARG VITE_TURNSTILE_SITE_KEY=0x4AAAAAADXRE_jtv9_OBFRo
ARG VITE_ADMIN_ALLOW_LOCAL=false
ENV VITE_TURNSTILE_ENABLED=$VITE_TURNSTILE_ENABLED
ENV VITE_TURNSTILE_SITE_KEY=$VITE_TURNSTILE_SITE_KEY
ENV VITE_ADMIN_ALLOW_LOCAL=$VITE_ADMIN_ALLOW_LOCAL
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
