{
  "name": "r2-proxy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:check": "node --env-file-if-exists=../.env node_modules/wrangler/bin/wrangler.js whoami",
    "deploy": "node --env-file-if-exists=../.env node_modules/wrangler/bin/wrangler.js deploy",
    "dev": "wrangler dev",
    "secret:backend": "node --env-file-if-exists=../.env node_modules/wrangler/bin/wrangler.js secret put BACKEND_INTERNAL_TOKEN",
    "start": "wrangler dev",
    "test": "vitest"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.19",
    "vitest": "^4.1.6",
    "wrangler": "^4.107.0"
  }
}
